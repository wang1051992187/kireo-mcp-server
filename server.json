{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.wang1051992187/kireo",
  "description": "Long-term memory for Claude Code, Cursor and any MCP client, with a searchable web dashboard.",
  "repository": {
    "url": "https://github.com/wang1051992187/kireo-mcp-server",
    "source": "github"
  },
  "version": "0.2.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@kireo/mcp-server",
      "version": "0.2.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "KIREO_API_KEY",
          "description": "API key from https://app.kireo.app/api-keys",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
